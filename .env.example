# ── ClickUp MCP Pro — environment ─────────────────────────────────────────

# REQUIRED — your ClickUp Personal API Token.
# Get it at: ClickUp → Settings → Apps → API Token (starts with "pk_")
CLICKUP_API_TOKEN=pk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — default Team/Workspace ID used when a tool omits team_id.
# Find it in the ClickUp URL: app.clickup.com/<TEAM_ID>/...
CLICKUP_TEAM_ID=

# OPTIONAL — set to "true" to block every write operation (create/update/delete).
# Read tools keep working. Great for safe exploration. Default: false.
CLICKUP_READONLY=false

# OPTIONAL — disable the clickup_raw escape-hatch tool (true/false). Default: false.
CLICKUP_DISABLE_RAW=false

# OPTIONAL — restrict upload_task_attachment(file_path) to this base directory.
# When unset, any path readable by the process is allowed. Set it to a safe
# folder to prevent arbitrary local-file exfiltration via attachments.
CLICKUP_UPLOAD_DIR=

# OPTIONAL — max attachment size in bytes for upload_task_attachment. Default: 52428800 (50 MB).
CLICKUP_MAX_UPLOAD_BYTES=52428800

# OPTIONAL — request timeout in milliseconds. Default: 60000.
CLICKUP_TIMEOUT_MS=60000

# OPTIONAL — max automatic retries on HTTP 429 / network errors. Default: 3.
CLICKUP_MAX_RETRIES=3
